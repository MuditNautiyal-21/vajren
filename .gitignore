# weights and runtimes — huge, never commit
models/
llama/
*.gguf
*.onnx
*.bin
*.safetensors

# secrets
.env
*.key
*.pem
credentials.json
token.json

# personal — the writing samples the writer lane learns your voice from.
# Never commit these. config/voice.example.md is the template that ships.
config/voice.md

# private — the build journal and anything else that is mine, not the public's.
# Its own git repo, pushed to a private remote and to the T7. Never goes here.
private/

# machine-specific / person-specific, written on first run
config/hardware.json
config/identity.json
config/audio-devices.json
config/llama-swap-version.txt
bin/

# runtime state
logs/
workspace/
sandbox/
memory/*.db
memory/*.db-wal
memory/*.db-shm
memory/index/
audit/

# python
__pycache__/
*.py[cod]
.venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# os / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# Vajren's own Chrome profile — cookies, logged-in sessions, downloads.
# This is a browser's private state. Never commit it, never back it up to a
# public remote, never share it. See core/browser.py.
browser/
