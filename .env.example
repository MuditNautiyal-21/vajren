# Copy to .env and fill in. NEVER commit .env.
# Long-term these should move into Windows Credential Manager via python `keyring`.
# .env is for non-secret config and bootstrap only.

# ---- free API tiers (fallback lane only — no personal data ever goes here) ----
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# ---- free non-LLM services ----
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SEARXNG_BASE_URL=http://127.0.0.1:8888

# ---- remote interface ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
NTFY_TOPIC_URL=

# ---- local endpoints ----
LLM_REFLEX_BASE=http://127.0.0.1:8082/v1
LLM_WORKHORSE_BASE=http://127.0.0.1:8081/v1
LLM_HEAVY_BASE=http://127.0.0.1:8083/v1
LITELLM_BASE=http://127.0.0.1:4000/v1

# ---- paths ----
VAJREN_ROOT=C:\vajren
# Models go on the INTERNAL NVMe (disk 0 / C:), not on F:.
# F: is a Samsung T7 Shield over USB. Model swaps read 18-22 GB at a time, and a
# USB drive that sleeps or gets unplugged takes a 24/7 assistant down with it.
# C: has ~456 GB free; the full bench is 60-80 GB.
VAJREN_MODELS=C:\vajren\models
